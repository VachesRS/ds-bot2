# Токен вашего Discord-бота (получите в https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# ID текстового канала для отправки логов автомодерации (необязательно, можно также настроить командой /setlogs)
LOG_CHANNEL_ID=0

# Бесплатный ключ API для AI-анализа картинок на NSFW (получите бесплатно на https://www.moderatecontent.com/)
# Если ключ не указан, работает встроенный фильтр NSFW-тегов и GIF-ссылок
MODERATECONTENT_API_KEY=
