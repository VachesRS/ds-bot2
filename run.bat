@echo off
chcp 65001 >nul
title Discord AutoMod Bot
:loop
echo ======================================================
echo [%date% %time%] Запуск Discord-бота...
echo ======================================================
python main.py
echo.
echo ======================================================
echo [%date% %time%] Бот завершил работу (код: %errorlevel%).
echo Перезапуск через 5 секунд... Нажмите Ctrl+C для выхода.
echo ======================================================
timeout /t 5
goto loop
